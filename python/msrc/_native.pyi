class ArchiveInfo:
    @property
    def container_version(self) -> int: ...
    @property
    def algorithm_id(self) -> int: ...
    @property
    def algorithm_version(self) -> int: ...
    @property
    def original_size(self) -> int: ...
    @property
    def payload_size(self) -> int: ...
    @property
    def original_crc32(self) -> int: ...
    @property
    def payload_crc32(self) -> int: ...

__version__: str

def compress(data: bytes, *, level: int = 6) -> bytes: ...
def decompress(
    data: bytes, *, max_output_size: int = 67108864, max_memory_kib: int = 65536
) -> bytes: ...
def inspect(data: bytes) -> ArchiveInfo: ...
